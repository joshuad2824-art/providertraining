{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ads/**",
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/navigation/**",
              "ui_kits/digital_advertising/**",
              "ui_kits/email_and_banners/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Frank Ruhl Libre|Roboto|Roboto Condensed))/i]",
        "message": "Font not provided by the design system. Available: Frank Ruhl Libre, Roboto, Roboto Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, children, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|urgent)$/]",
        "message": "<Alert> tone must be one of 'info' | 'success' | 'warning' | 'urgent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|crop|bleed|arch|assetBase|minHeight|padding|style|children|key|ref|className|style|children)$/]",
        "message": "<ArchPanel> doesn't accept that prop. Declared props: color, crop, bleed, arch, assetBase, minHeight, padding, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchPanel'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|medium-blue|green|violet|gold)$/]",
        "message": "<ArchPanel> color must be one of 'blue' | 'medium-blue' | 'green' | 'violet' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchPanel'] > JSXAttribute[name.name='crop'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<ArchPanel> crop must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchPanel'] > JSXAttribute[name.name='bleed'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<ArchPanel> bleed must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|subtle|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, subtle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|medium-blue|green|violet|gold|neutral)$/]",
        "message": "<Badge> tone must be one of 'blue' | 'medium-blue' | 'green' | 'violet' | 'gold' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumbs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumbs> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|arrow|icon|href|disabled|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, arrow, icon, href, disabled, fullWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|emphasis|outline|white|outline-white|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'emphasis' | 'outline' | 'white' | 'outline-white' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|accent|interactive|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, accent, interactive, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:blue|medium-blue|green|violet|gold)$/]",
        "message": "<Card> accent must be one of 'blue' | 'medium-blue' | 'green' | 'violet' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, description, checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|onClose|width|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, footer, onClose, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayAd'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|eyebrow|headline|cta|logo|assetBase|bleed|style|key|ref|className|style|children)$/]",
        "message": "<DisplayAd> doesn't accept that prop. Declared props: size, color, eyebrow, headline, cta, logo, assetBase, bleed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayAd'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:160x600|300x600|300x250|728x90|320x50|300x50)$/]",
        "message": "<DisplayAd> size must be one of '160x600' | '300x600' | '300x250' | '728x90' | '320x50' | '300x50'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayAd'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|medium-blue|green|violet|gold)$/]",
        "message": "<DisplayAd> color must be one of 'blue' | 'medium-blue' | 'green' | 'violet' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayAd'] > JSXAttribute[name.name='logo'] > Literal[value!=/^(?:st-john-horizontal|st-john-horizontal-stacked|horizontal|vertical)$/]",
        "message": "<DisplayAd> logo must be one of 'st-john-horizontal' | 'st-john-horizontal-stacked' | 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayAd'] > JSXAttribute[name.name='bleed'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<DisplayAd> bleed must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|as|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, color, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeAware|base|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeAware, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:lockup|color|height|clearspace|assetBase|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: lockup, color, height, clearspace, assetBase, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='lockup'] > Literal[value!=/^(?:st-john-horizontal|st-john-horizontal-stacked|st-john-vertical|horizontal|vertical|emblem)$/]",
        "message": "<Logo> lockup must be one of 'st-john-horizontal' | 'st-john-horizontal-stacked' | 'st-john-vertical' | 'horizontal' | 'vertical' | 'emblem'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:fc|wht|blk|blue|medium-blue|green|violet|gold)$/]",
        "message": "<Logo> color must be one of 'fc' | 'wht' | 'blk' | 'blue' | 'medium-blue' | 'green' | 'violet' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|checked|onChange|name|value|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, description, checked, onChange, name, value, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|options|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, hint, options, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label, checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|onRemove|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, selected, onRemove, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|placement|style|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, children, placement, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Tooltip> placement must be one of 'top' | 'bottom'."
      }
    ]
  },
